# Copy this file to .env and fill in the values. NEVER share your .env file (it contains the bot token).

# ---------- Bot (Developer Portal: https://discord.com/developers/applications) ----------
# Bot tab → Reset Token
DISCORD_TOKEN=your_token_here
# General Information tab → Application ID
CLIENT_ID=your_application_id
# Test server for "npm run deploy -- --test" (commands available instantly, on this server only)
GUILD_ID=your_test_server_id
# Privileged intents (Server Members, Message Content) are detected automatically on startup:
# enable them in the Developer Portal (Bot tab) for welcome messages, full logs, statistics and the AI.

# ---------- Web dashboard ----------
# OAuth2 tab: copy the Client Secret and add the redirect <DASHBOARD_URL>/callback (e.g. http://localhost:3000/callback)
CLIENT_SECRET=
# A long random string: keeps people logged in across restarts
SESSION_SECRET=
DASHBOARD_PORT=3000
# Public address of the dashboard (e.g. https://bot.mydomain.com once hosted)
DASHBOARD_URL=http://localhost:3000

# ---------- Security ----------
# Encrypts the AI keys, the Twitch secret and the RCON passwords saved in data/ (64 hex characters).
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Keep it safe: if you lose or change it, the saved keys and passwords have to be entered again.
ENCRYPTION_KEY=

# ---------- Optional ----------
# Twitch alerts: create a free application at https://dev.twitch.tv/console
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
# Optional AI keys of the bot owner: only used on the servers you own, when they have no key of their own.
# The usual way is to set the AI and its key per server, in the dashboard's "Server AI" tab.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
MISTRAL_API_KEY=
DEEPSEEK_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
# Free local AI (Ollama, LM Studio…): address of its OpenAI-compatible API, e.g. http://localhost:11434/v1
LOCAL_AI_URL=
LOCAL_AI_KEY=
